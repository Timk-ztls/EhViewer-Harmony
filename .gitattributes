# 全仓强制 LF（Windows 上的 CRLF 会让 diff/合并/行号检查全部失真）
* text=auto eol=lf
*.ets  text eol=lf
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.ps1  text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.java text eol=lf
*.kt   text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.zip  binary
*.7z   binary
*.hap  binary
*.so   binary
*.protoBin binary
